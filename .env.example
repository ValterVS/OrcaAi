# Copy to .env and fill in local values. Never commit .env.

# Local PostgreSQL (docker compose and the backend "dev" profile).
# POSTGRES_USER owns the schema and runs migrations.
POSTGRES_DB=orcaai
POSTGRES_USER=orcaai
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Restricted runtime user used by the application (created on first "docker compose up").
APP_DB_USER=orcaai_app
APP_DB_PASSWORD=change-me-too

# Optional: creates a first organization and owner user on startup (dev profile only)
DEV_BOOTSTRAP_EMAIL=
DEV_BOOTSTRAP_PASSWORD=

# Email. In development the backend sends to Mailpit (docker compose); open http://localhost:8025.
# Production: set MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD of the SMTP provider (STARTTLS on by default).
MAIL_FROM=nao-responda@orcaai.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Base URL of the frontend, used in links sent by email (never taken from the request Host header).
APP_PUBLIC_URL=http://localhost:3000
